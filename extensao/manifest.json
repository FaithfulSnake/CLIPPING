{
  "manifest_version": 3,
  "name": "Ferramentas Fanjas",
  "short_name": "Fanjas",
  "version": "1.2.0",
  "description": "Ferramentas do escritório: prints com rolagem (página inteira em ZIP numerado) e e-mails de notícias jurídicas com o texto integral das matérias.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "clipboardWrite", "clipboardRead", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ferramentas Fanjas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "commands": {
    "iniciar-captura": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Iniciar (ou parar) a captura com as últimas opções usadas"
    }
  }
}
