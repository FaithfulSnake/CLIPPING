{
  "manifest_version": 3,
  "name": "Clipping – Prints com rolagem",
  "short_name": "Prints com rolagem",
  "version": "1.0.0",
  "description": "Rola a página do topo ao fim, tira um print de cada trecho e baixa um ZIP com os prints numerados (001, 002…).",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Prints com rolagem",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "commands": {
    "iniciar-captura": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Iniciar (ou parar) a captura com as últimas opções usadas"
    }
  }
}
