{
  "manifest_version": 3,
  "name": "Ferramentas Fanjas",
  "short_name": "Fanjas",
  "version": "1.5.0",
  "description": "Ferramentas do escritório: transcrição das matérias direto para o e-mail de notícias jurídicas (texto integral, sem resumo), prints com rolagem em ZIP numerado e OCR embutido.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "clipboardWrite", "clipboardRead", "tabs", "downloads"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ferramentas Fanjas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "commands": {
    "iniciar-captura": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Iniciar (ou parar) a captura com as últimas opções usadas"
    }
  }
}
